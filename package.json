{
	"name": "@kisakay/luna-downloads",
	"description": "Download-only TidaLuna plugin store by Kisakay (DownloadManager, advanced downloader)",
	"author": {
		"name": "Kisakay",
		"url": "https://github.com/Kisakay",
		"avatarUrl": "https://github.com/Kisakay.png"
	},
	"homepage": "https://github.com/Kisakay/luna-plugins",
	"repository": {
		"type": "git",
		"url": "https://github.com/Kisakay/luna-plugins.git"
	},
	"type": "module",
	"scripts": {
		"watch": "concurrently npm:esWatch npm:serve",
		"prebuild": "node ./plugins/DownloadManager/scripts/sync-winml-css.mjs",
		"build": "rimraf ./dist && tsx esbuild.config.ts",
		"esWatch": "rimraf ./dist && tsx ./esbuild.config.ts --watch",
		"serve": "http-server ./dist -p 3000 -s --cors -c-1"
	},
	"devDependencies": {
		"@inrixia/helpers": "^3.21.2",
		"@types/node": "^25.0.10",
		"@types/react": "^19.2.9",
		"@types/react-dom": "^19.2.3",
		"concurrently": "^9.2.1",
		"electron": "^40.0.0",
		"http-server": "^14.1.1",
		"luna": "github:Inrixia/TidaLuna",
		"oby": "^15.1.2",
		"rimraf": "^6.1.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}